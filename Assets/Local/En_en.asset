%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: En_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 4011844a6fca3f8488675c3ebf296a70, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 746645323776
    m_Localized: "Enemies appear infinitely. \nProve yourself."
    m_Metadata:
      m_Items: []
  - m_Id: 749015105536
    m_Localized: "You can adjust the enemy \nsummoning probability \nas you wish."
    m_Metadata:
      m_Items: []
  - m_Id: 751166783488
    m_Localized: Go to the end of the dungeon and defeat the last enemy.
    m_Metadata:
      m_Items: []
  - m_Id: 1476185784320
    m_Localized: Reincarnate. Upon reincarnation, all current levels will be reset,
      and you will receive 1 Reincarnation Point in return. (Minimum Level 10)
    m_Metadata:
      m_Items: []
  - m_Id: 1948154036224
    m_Localized: 'A dragon that controls light

      Has the power to block all
      light

      (Blocks your screen)'
    m_Metadata:
      m_Items: []
  - m_Id: 2489982615552
    m_Localized: 'Intelligent Sorcerer

      Especially talented in material transformation

      (Changes
      your gem into a + shape)'
    m_Metadata:
      m_Items: []
  - m_Id: 2607750283264
    m_Localized: 'Unenlightened souls

      Like to hide

      (Makes your gems
      transparent)'
    m_Metadata:
      m_Items: []
  - m_Id: 199070866440192
    m_Localized: 'He is a knight with a large sword

      He cuts you down with
      his large sword

      (Swap fast fall and slam)'
    m_Metadata:
      m_Items: []
  - m_Id: 199616826408960
    m_Localized: 'Mischievous Clown

      Cunningly flips your bag

      (Stock
      is forcibly changed)'
    m_Metadata:
      m_Items: []
  - m_Id: 200683349835776
    m_Localized: "Spray red ink that looks like a giant squid and \nsoak your bag\r\n(Bag
      and stock are not visible)"
    m_Metadata:
      m_Items: []
  - m_Id: 200832096632832
    m_Localized: "The large golem strikes the ground, \nshaking the earth.\r\n(The
      screen shakes)"
    m_Metadata:
      m_Items: []
  - m_Id: 248065106083840
    m_Localized: 'In reality, it strikes the ground with an enemy about three times
      the size of a goblin, flipping the earth.

      (Flips the screen horizontally)'
    m_Metadata:
      m_Items: []
  - m_Id: 248068100816896
    m_Localized: Simply attack pudding-like enemies.
    m_Metadata:
      m_Items: []
  - m_Id: 249417882370048
    m_Localized: 'An enemy that plunders the opponent''s resources

      Steals
      what you have saved for the future

      (Takes away your stock)'
    m_Metadata:
      m_Items: []
  - m_Id: 1274621840556032
    m_Localized: He finds far greater value in your self-destruction than in your
      death. As an Outer God, he is the master of all existence, wielding every power
      imaginable.
    m_Metadata:
      m_Items: []
  - m_Id: 2006629998886912
    m_Localized: Not enough points!
    m_Metadata:
      m_Items: []
  - m_Id: 2006667688902656
    m_Localized: Max level reached!
    m_Metadata:
      m_Items: []
  - m_Id: 2006917740724224
    m_Localized: Level Up!
    m_Metadata:
      m_Items: []
  - m_Id: 2006918625722368
    m_Localized: 'Points:'
    m_Metadata:
      m_Items: []
  - m_Id: 2442587168800768
    m_Localized: Fill a horizontal row with gems to deal damage to enemies and clear
      the line.
    m_Metadata:
      m_Items: []
  - m_Id: 2442976261799936
    m_Localized: An enemy that constantly interferes with your progress, but grants
      health recovery upon defeat
    m_Metadata:
      m_Items: []
  - m_Id: 2443741382541312
    m_Localized: 'Gain 1 Attribute Point per Level Up to upgrade your stats.

      MAX
      HP: Increases your maximum Health.

      ATK: Increases overall damage output.

      SPD:
      Reduces the falling speed of gems for better control.

      INT: Increases
      the number of "Next" minerals shown.'
    m_Metadata:
      m_Items: []
  - m_Id: 2446056059535360
    m_Localized: 'If a hole appears in the middle that absolutely cannot be inserted,
      it will take slight damage.

'
    m_Metadata:
      m_Items: []
  - m_Id: 6339866615316480
    m_Localized: Start
    m_Metadata:
      m_Items: []
  - m_Id: 6340072861827072
    m_Localized: Quit
    m_Metadata:
      m_Items: []
  - m_Id: 6340094043062272
    m_Localized: Reset Level
    m_Metadata:
      m_Items: []
  - m_Id: 7190543260418048
    m_Localized: 'If you use an HP recovery potion, 20 HP will be restored.

'
    m_Metadata:
      m_Items: []
  - m_Id: 7225159916683264
    m_Localized: 'Each class has its own base stats and class skills. Base stats
      cannot be reduced further. Additionally, the class can be changed upon reincarnation.

'
    m_Metadata:
      m_Items: []
  - m_Id: 7227659600232448
    m_Localized: 'Starts with 20 additional HP.



      Class Skill: Increases damage
      by 50% for 6 seconds.'
    m_Metadata:
      m_Items: []
  - m_Id: 7248199337607168
    m_Localized: 'Starts with 2 additional SPD.



      Class Skill: Evade 2 attacks.'
    m_Metadata:
      m_Items: []
  - m_Id: 7248367210430464
    m_Localized: 'Starts with +2 additional ATK.



      Class Skill: Double Attack'
    m_Metadata:
      m_Items: []
  - m_Id: 7248367915073536
    m_Localized: '

      Starts with 2 additional INT.



      Class Skill: Enemies
      are unable to attack for 6 seconds.'
    m_Metadata:
      m_Items: []
  - m_Id: 7439850827907072
    m_Localized: 'If you reincarnate, you will gain Reincarnation Points, all levels
      will be reset to 0, and you can re-select your class. Additionally, reincarnation
      is possible starting from level 5. Reincarnation Points can be used to purchase
      skills.

'
    m_Metadata:
      m_Items: []
  - m_Id: 7505624808521728
    m_Localized: Recovers 0.25 per level for every gem slot removed (Number of removed
      gem slots * Level * 0.25)
    m_Metadata:
      m_Items: []
  - m_Id: 7506353094885376
    m_Localized: Whenever you attack with a gem, there is a certain probability of
      stunning the opponent.
    m_Metadata:
      m_Items: []
  - m_Id: 7506684944023552
    m_Localized: 'Whenever you attack with a gem, there is a certain probability
      of gaining a shield twice.

'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
