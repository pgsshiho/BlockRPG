  m_TableData:
  - m_Id: 746645323776
    m_Localized: "\uBB34\uD55C\uC73C\uB85C \n\uC801\uC774\uB098\uC635\uB2C8\uB2E4\n\uB2F9\uC2E0\uC744
      \uC99D\uBA85\uD558\uC138\uC694\n"
    m_Metadata:
      m_Items: []
  - m_Id: 749015105536
    m_Localized: "\uCEE4\uC2A4\uD140 \uBAA8\uB4DC \uC785\uB2C8\uB2E4 \n\uC801\uB4E4\uC758
      \uC18C\uD658 \uD655\uB960\uC744 \n\uC6D0\uD558\uB294 \uB300\uB85C \n\uC870\uC815
      \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 751166783488
    m_Localized: "\uB358\uC804 \uBAA8\uB4DC\uC785\uB2C8\uB2E4.\n\uB358\uC804\uB05D\uC73C\uB85C\uAC00
      \n\uB9C8\uC9C0\uB9C9 \uC801\uC744 \n\uCC98\uCE58\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1476185784320
    m_Localized: "\uCD08\uAE30\uD654 \uD558\uBA74 \uB808\uBCA8 \uBC0F \uBAA8\uB4E0
      \uC2A4\uD0EF\uC774 \n\uAE30\uBCF8 \uC0C1\uD0DC\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4
      \n\uC815\uB9D0 \uCD08\uAE30\uD654 \uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1948154036224
    m_Localized: "\uBE5B\uC744 \uB2E4\uB8E8\uB294 \uC6A9\n\uBAA8\uB4E0 \uBE5B\uC744
      \uAC00\uB9B4 \uD798\uC744 \uAC00\uC84C\uB2E4\n(\uB2F9\uC2E0\uC758 \uD654\uBA74\uC744
      \uAC00\uB9BD\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 2489982615552
    m_Localized: "\uCD1D\uBA85\uD55C \uC8FC\uC220\uC0AC\n\uD2B9\uD788 \uBB3C\uC9C8\uBCC0\uD615\uC5D0
      \uC7AC\uB2A5\uC774 \uC788\uB2E4\n(\uB2F9\uC2E0\uC758 \uBCF4\uC11D\uC744 + \uBAA8\uC559\uC73C\uB85C
      \uBC14\uAFC9\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 2607750283264
    m_Localized: "\uC131\uBD88\uD558\uC9C0 \uBABB\uD55C \uC601\uD63C\n\uC228\uAE30\uB294
      \uAC83\uC744 \uC88B\uC544\uD55C\uB2E4\n(\uB2F9\uC2E0\uC758 \uBCF4\uC11D\uC744
      \uD22C\uBA85\uD654 \uC2DC\uD0B5\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 199070866440192
    m_Localized: "\uCEE4\uB2E4\uB780 \uAC80\uC744 \uAC00\uC9C4 \uAE30\uC0AC\uC774\uB2E4\n\uCEE4\uB2E4\uB780
      \uAC80\uC73C\uB85C \uB2F9\uC2E0\uC744 \uBCA0\uC5B4\uB0C5\uB2C8\uB2E4\n(fast
      fall\uACFC slam\uC744 \uB4A4\uBC14\uAFC9\uB2C8\uB2E4)\n"
    m_Metadata:
      m_Items: []
  - m_Id: 199616826408960
    m_Localized: "\uC7A5\uB09C\uC2A4\uB7EC\uC6B4 \uAD11\uB300\n\uAD50\uD65C\uD558\uAC8C
      \uB2F9\uC2E0\uC758 \uAC00\uBC29\uC744 \uB4A4\uC9D1\uB2C8\uB2E4\n(Stock\uC774
      \uAC15\uC81C\uB85C \uBC14\uB01D\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 200683349835776
    m_Localized: "\uB300\uD615\uC624\uC9D5\uC5B4 \uCC98\uB7FC \uC0DD\uAE34 \uC801
      \uBA39\uBB3C\uC744 \uBFCC\uB824 \n\uB2F9\uC2E0\uC758 \uAC00\uBC29\uC744 \uC801\uC2E0\uB2E4\n(bag
      \uBC0F stock\uC774 \uBCF4\uC774\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 200832096632832
    m_Localized: "\uCEE4\uB2E4\uB780 \uACE8\uB818 \uBC14\uB2E5\uC744 \uB0B4\uB824\uCCD0
      \n\uC9C0\uBC18\uC744 \uD754\uB4E0\uB2E4\n(\uD654\uBA74\uC774 \uD754\uB4E4\uB9BD\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 248065106083840
    m_Localized: "\uC2E4\uC81C\uB860 \uACE0\uBE14\uB9B0\uC758 3\uBC30\uC815\uB3C4
      \uB418\uB294 \uD06C\uAE30\uC758 \uC801 \uB545\uC744 \uB0B4\uB824\uCCD0 \uC9C0\uBC18\uC744
      \uB4A4\uBC14\uAFBC\uB2E4\n(\uD654\uBA74\uC744 \uC88C\uC6B0\uBC18\uC804 \uC2DC\uD0A8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 248068100816896
    m_Localized: "\uD478\uB529\uAC19\uC740 \uC801 \uB2E8\uC21C\uD788 \uACF5\uACA9\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 249417882370048
    m_Localized: "\uC0C1\uB300\uC758 \uC790\uC6D0\uC744 \uC57D\uD0C8\uD558\uB294
      \uC801\uC774\uB2E4\n\uB2F9\uC2E0\uC774 \uBBF8\uB798\uB97C \uC704\uD574 \n\uB0A8\uACA8\uB193\uC740
      \uAC83\uB4E4\uC744 \uD6D4\uCE5C\uB2E4\n(\uB2F9\uC2E0\uC758 stock\uC744 \uBE7C\uC557\uC544\uAC11\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 1274621840556032
    m_Localized: "\uADF8\uB294 \uB2F9\uC2E0\uC744 \uC8FD\uC774\uB294 \uAC83\uBCF4\uB2E4,
      \n\uB2F9\uC2E0\uC774 \uC2A4\uC2A4\uB85C \uBB34\uB108\uC9C0\uB294 \uAC83\uC744
      \uB354 \uAC00\uCE58 \uC788\uAC8C \uC5EC\uAE41\uB2C8\uB2E4.\n \uADF8\uB294 \uC678\uC2E0\uC778\uC9C0\uB77C
      \uBAA8\uB4E0 \uB2A5\uB825\uC744 \uC0AC\uC6A9\uD558\uB294 \uC874\uC7AC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2006629998886912
    m_Localized: Not enough points!
    m_Metadata:
      m_Items: []
  - m_Id: 2006667688902656
    m_Localized: Max level reached!
    m_Metadata:
      m_Items: []
