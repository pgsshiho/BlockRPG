  m_SharedData: {fileID: 11400000, guid: 4011844a6fca3f8488675c3ebf296a70, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 746645323776
    m_Localized: "\uBB34\uD55C\uC73C\uB85C \n\uC801\uC774\uB098\uC635\uB2C8\uB2E4\n\uB2F9\uC2E0\uC744
      \uC99D\uBA85\uD558\uC138\uC694\n"
    m_Metadata:
      m_Items: []
  - m_Id: 749015105536
    m_Localized: "\uCEE4\uC2A4\uD140 \uBAA8\uB4DC \uC785\uB2C8\uB2E4 \n\uC801\uB4E4\uC758
      \uC18C\uD658 \uD655\uB960\uC744 \n\uC6D0\uD558\uB294 \uB300\uB85C \n\uC870\uC815
      \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 751166783488
    m_Localized: "\uB358\uC804 \uBAA8\uB4DC\uC785\uB2C8\uB2E4.\n\uB358\uC804\uB05D\uC73C\uB85C\uAC00
      \n\uB9C8\uC9C0\uB9C9 \uC801\uC744 \n\uCC98\uCE58\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1476185784320
    m_Localized: "\uD658\uC0DD\uD569\uB2C8\uB2E4 \uD658\uC0DD\uD558\uAC8C \uB41C\uB2E4\uBA74
      \uD604\uC7AC \uAC00\uC9C4 \uBAA8\uB4E0 \uB808\uBCA8\uC744 \uCD08\uAE30\uD654
      \uD558\uACE0 \uB300\uC2E0 \uD658\uC0DD\uD3EC\uC778\uD2B8 1\uC744 \uD68D\uB4DD
      \uD569\uB2C8\uB2E4\n(\uCD5C\uC18C\uB808\uBCA8 10)"
    m_Metadata:
      m_Items: []
  - m_Id: 1948154036224
    m_Localized: "\uBE5B\uC744 \uB2E4\uB8E8\uB294 \uC6A9\n\uBAA8\uB4E0 \uBE5B\uC744
      \uAC00\uB9B4 \uD798\uC744 \uAC00\uC84C\uB2E4\n(\uB2F9\uC2E0\uC758 \uD654\uBA74\uC744
      \uAC00\uB9BD\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 2489982615552
    m_Localized: "\uCD1D\uBA85\uD55C \uC8FC\uC220\uC0AC\n\uD2B9\uD788 \uBB3C\uC9C8\uBCC0\uD615\uC5D0
      \uC7AC\uB2A5\uC774 \uC788\uB2E4\n(\uB2F9\uC2E0\uC758 \uBCF4\uC11D\uC744 + \uBAA8\uC559\uC73C\uB85C
      \uBC14\uAFC9\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 2607750283264
    m_Localized: "\uC131\uBD88\uD558\uC9C0 \uBABB\uD55C \uC601\uD63C\n\uC228\uAE30\uB294
      \uAC83\uC744 \uC88B\uC544\uD55C\uB2E4\n(\uB2F9\uC2E0\uC758 \uBCF4\uC11D\uC744
      \uD22C\uBA85\uD654 \uC2DC\uD0B5\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 199070866440192
    m_Localized: "\uCEE4\uB2E4\uB780 \uAC80\uC744 \uAC00\uC9C4 \uAE30\uC0AC\uC774\uB2E4\n\uCEE4\uB2E4\uB780
      \uAC80\uC73C\uB85C \uB2F9\uC2E0\uC744 \uBCA0\uC5B4\uB0C5\uB2C8\uB2E4\n(fast
      fall\uACFC slam\uC744 \uB4A4\uBC14\uAFC9\uB2C8\uB2E4)\n"
    m_Metadata:
      m_Items: []
  - m_Id: 199616826408960
    m_Localized: "\uC7A5\uB09C\uC2A4\uB7EC\uC6B4 \uAD11\uB300\n\uAD50\uD65C\uD558\uAC8C
      \uB2F9\uC2E0\uC758 \uAC00\uBC29\uC744 \uB4A4\uC9D1\uB2C8\uB2E4\n(Stock\uC774
      \uAC15\uC81C\uB85C \uBC14\uB01D\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 200683349835776
    m_Localized: "\uB300\uD615\uC624\uC9D5\uC5B4 \uCC98\uB7FC \uC0DD\uAE34 \uC801
      \uBA39\uBB3C\uC744 \uBFCC\uB824 \n\uB2F9\uC2E0\uC758 \uAC00\uBC29\uC744 \uC801\uC2E0\uB2E4\n(bag
      \uBC0F stock\uC774 \uBCF4\uC774\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 200832096632832
    m_Localized: "\uCEE4\uB2E4\uB780 \uACE8\uB818 \uBC14\uB2E5\uC744 \uB0B4\uB824\uCCD0
      \n\uC9C0\uBC18\uC744 \uD754\uB4E0\uB2E4\n(\uD654\uBA74\uC774 \uD754\uB4E4\uB9BD\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 248065106083840
    m_Localized: "\uC2E4\uC81C\uB860 \uACE0\uBE14\uB9B0\uC758 3\uBC30\uC815\uB3C4
      \uB418\uB294 \uD06C\uAE30\uC758 \uC801 \uB545\uC744 \uB0B4\uB824\uCCD0 \uC9C0\uBC18\uC744
      \uB4A4\uBC14\uAFBC\uB2E4\n(\uD654\uBA74\uC744 \uC88C\uC6B0\uBC18\uC804 \uC2DC\uD0A8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 248068100816896
    m_Localized: "\uD478\uB529\uAC19\uC740 \uC801 \uB2E8\uC21C\uD788 \uACF5\uACA9\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 249417882370048
    m_Localized: "\uC0C1\uB300\uC758 \uC790\uC6D0\uC744 \uC57D\uD0C8\uD558\uB294
      \uC801\uC774\uB2E4\n\uB2F9\uC2E0\uC774 \uBBF8\uB798\uB97C \uC704\uD574 \n\uB0A8\uACA8\uB193\uC740
      \uAC83\uB4E4\uC744 \uD6D4\uCE5C\uB2E4\n(\uB2F9\uC2E0\uC758 stock\uC744 \uBE7C\uC557\uC544\uAC11\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 1274621840556032
    m_Localized: "\uADF8\uB294 \uB2F9\uC2E0\uC744 \uC8FD\uC774\uB294 \uAC83\uBCF4\uB2E4,
      \n\uB2F9\uC2E0\uC774 \uC2A4\uC2A4\uB85C \uBB34\uB108\uC9C0\uB294 \uAC83\uC744
      \uB354 \uAC00\uCE58 \uC788\uAC8C \uC5EC\uAE41\uB2C8\uB2E4.\n \uADF8\uB294 \uC678\uC2E0\uC778\uC9C0\uB77C
      \uBAA8\uB4E0 \uB2A5\uB825\uC744 \uC0AC\uC6A9\uD558\uB294 \uC874\uC7AC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2006629998886912
    m_Localized: "\uD3EC\uC778\uD2B8 \uBD80\uC871!"
    m_Metadata:
      m_Items: []
  - m_Id: 2006667688902656
    m_Localized: "\uCD5C\uB300\uCE58 \uB3C4\uB2EC!"
    m_Metadata:
      m_Items: []
  - m_Id: 2006917740724224
    m_Localized: "\uB808\uBCA8 \uC5C5!"
    m_Metadata:
      m_Items: []
  - m_Id: 2006918625722368
    m_Localized: "\uD3EC\uC778\uD2B8:"
    m_Metadata:
      m_Items: []
  - m_Id: 2442587168800768
    m_Localized: "\uBCF4\uC11D\uC774\uB2E4. \uC774 \uBCF4\uC11D\uC744 \uAC00\uB85C\uB85C
      \uD55C \uC904\uC744 \uCC44\uC6B0\uBA74 \uC801\uC5D0\uAC8C \uB370\uBBF8\uC9C0\uB97C
      \uC785\uD788\uACE0 \uD55C \uC904\uC774 \uC0AC\uB77C\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2442976261799936
    m_Localized: "\uC801\uC774 \uB2E4 \uB098\uB97C \uC9C0\uC18D\uC801\uC73C\uB85C
      \uBC29\uD574\uD574 \uC624\uC9C0\uB9CC \uC7A1\uC73C\uBA74 \uC57D\uAC04\uC758
      \uCCB4\uB825 \uD68C\uBCF5\uC774 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2443741382541312
    m_Localized: "\uB808\uBCA8 \uC5C5\uC744 \uD1B5\uD574 \uD68D\uB4DD\uD55C \uC131\uC7A5
      \uD3EC\uC778\uD2B8(1pt)\uB97C \uC0AC\uC6A9\uD558\uC5EC \uC2E0\uCCB4\uB97C \uB2E8\uB828\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\nMAX HP (\uC0DD\uBA85\uB825): \uBAA8\uD5D8\uC758
      \uC9C0\uC18D\uB825\uC744 \uACB0\uC815\uC9D3\uB294 \uCD5C\uB300 \uCCB4\uB825\uC774
      \uC99D\uAC00\uD569\uB2C8\uB2E4.\nATK (\uACF5\uACA9\uB825): \uC801\uC5D0\uAC8C
      \uAC00\uD558\uB294 \uD0C0\uACA9 \uCE58\uBA85\uC0C1\uC774 \uB354\uC6B1 \uAC15\uB825\uD574\uC9D1\uB2C8\uB2E4.\nSPD
      (\uC2E0\uC18D\uD568): \uC815\uAD50\uD55C \uC190\uB180\uB9BC\uC73C\uB85C \uBCF4\uC11D\uC774
      \uB099\uD558\uD558\uB294 \uC18D\uB3C4\uB97C \uC81C\uC5B4(\uAC10\uC18C)\uD569\uB2C8\uB2E4.\nINT
      (\uD1B5\uCC30\uB825): \uC2EC\uC548\uC744 \uD1B5\uD574 \uBBF8\uB9AC \uB0B4\uB2E4\uBCFC
      \uC218 \uC788\uB294 \uAD11\uBB3C\uC758 \uAC1C\uC218\uAC00 \uB298\uC5B4\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2446056059535360
    m_Localized: "\uC911\uAC04\uC5D0 \uC808\uB300 \uB123\uC744 \uC218 \uC5C6\uB294
      \uAD6C\uBA4D\uC774 \uC0DD\uAE34\uB2E4\uBA74 \uC57D\uAC04\uC758 \uB370\uBBF8\uC9C0\uB97C
      \uC785\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 6339866615316480
    m_Localized: "\uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 6340072861827072
    m_Localized: "\uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 6340094043062272
    m_Localized: "\uD658\uC0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 7190543260418048
    m_Localized: "HP\uD68C\uBCF5 \uD3EC\uC158\r\n\uC0AC\uC6A9\uC744 \uD558\uAC8C
      \uB41C\uB2E4\uBA74\r\n\uCCB4\uB825 20\uC774 \uD68C\uBCF5\uB3C4\uB41C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7225159916683264
    m_Localized: "\uAC01 \uD074\uB798\uC2A4\uB294 \uAC01\uAC01\uC758 \uAE30\uC874
      \uC2A4\uD0EF\uACFC \uAC01 \uD074\uB798\uC2A4 \uC2A4\uD0AC\uC744 \uAC00\uC9C0\uACE0
      \uC788\uC2B5\uB2C8\uB2E4. \uAC01 \uAE30\uC874\uC2A4\uD0EF\uC740 \uB354 \uC904\uC77C
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uB610\uD55C \uD658\uC0DD\uC2DC \uC9C1\uC5C5\uC774
      \uBCC0\uACBD \uAC00\uB2A5\uD569\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7227659600232448
    m_Localized: "\uCD94\uAC00 \uCCB4\uB825 20\uC744 \uAC00\uC9C0\uACE0 \uC2DC\uC791\uD569\uB2C8\uB2E4.\r\n\uD074\uB798\uC2A4
      \uC2A4\uD0AC : 6\uCD08\uB3D9\uC548 \uB370\uBBF8\uC9C0 50% \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 7248199337607168
    m_Localized: "\uCD94\uAC00 SPD 2\uB97C \uD68D\uB4DD \uD558\uACE0 \uC2DC\uC791\uD569\uB2C8\uB2E4.\r\n\uD074\uB798\uC2A4
      \uC2A4\uD0AC: \uACF5\uACA9 2\uD68C \uD68C\uD53C"
    m_Metadata:
      m_Items: []
  - m_Id: 7248367210430464
    m_Localized: "\uCD94\uAC00 ATK 2\uB97C \uD68D\uB4DD\uD558\uACE0 \uC2DC\uC791\uD569\uB2C8\uB2E4.\r\n\uD074\uB798\uC2A4
      \uC2A4\uD0AC: 2\uD68C\uC5F0 \uACF5\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 7248367915073536
    m_Localized: "\uCD94\uAC00 INT 2\uB97C \uD68C\uB4DD\uD558\uACE0 \uC2DC\uC791\uD569\uB2C8\uB2E4.\r\n\uD074\uB798\uC2A4
      \uC2A4\uD0AC: \uC801\uC774 6\uCD08\uB3D9\uC548 \uACF5\uACA9 \uBD88\uAC00 \uC0C1\uD0DC"
    m_Metadata:
      m_Items: []
  - m_Id: 7439850827907072
    m_Localized: "\uD658\uC0DD\uC744 \uD558\uAC8C \uB41C\uB2E4\uBA74 \uD658\uC0DD\uD3EC\uC778\uD2B8\uB97C
      \uC5BB\uACE0 \uBAA8\uB4E0 \uB808\uBCA8\uC774 0\uC73C\uB85C \uCD08\uAE30\uD654
      \uBC0F \uC9C1\uC5C5\uC744 \uB2E4\uC2DC \uC120\uD0DD\uAC00\uB2A5\uD569\uB2C8\uB2E4
      \uB610\uD55C 5\uB808\uBCA8 \uBD80\uD130 \uD658\uC0DD\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4
      \uD658\uC0DD\uD3EC\uC778\uD2B8\uB85C\uB294 \uC2A4\uD0AC\uB4E4\uC744 \uAD6C\uB9E4\uAC00
      \uAC00\uB2A5\uD569\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7505624808521728
    m_Localized: "\uBCF4\uC11D 1\uCE78\uB2F9 \uB808\uBCA8\uB9C8\uB2E4 0.25\uC529
      \uD68C\uBCF5\uD569\uB2C8\uB2E4 \r\n(\uC81C\uAC70\uB41C \uBCF4\uC11D \uCE78\uC218
      * \uB808\uBCA8 * 0.25)"
    m_Metadata:
      m_Items: []
  - m_Id: 7506353094885376
    m_Localized: "\uBCF4\uC11D\uC73C\uB85C \uACF5\uACA9\uD560\uB54C\uB9C8\uB2E4 \uC77C\uC815
      \uD655\uB960\uB85C \uC0C1\uB300\uB97C \uAE30\uC808 \uC2DC\uD0B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 7506684944023552
    m_Localized: "\uBCF4\uC11D\uC73C\uB85C \uACF5\uACA9\uD560\uB54C\uB9C8\uB2E4 \uC77C\uC815
      \uD655\uB960\uB85C 2\uD68C \uBC29\uC5B4\uB9C9\uC744 \uC5BB\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 8985239917920256
    m_Localized: "\uD658\uC0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 14120726391390208
    m_Localized: "\uC8FC\uC758\r\n\uBAA8\uB4E0 \uC138\uC774\uBE0C \uD30C\uC77C\uC744
      \uC5C6\uC560\uB294 \uAC83\uC73C\uB85C \uBC84\uADF8\uB97C \uC2A4\uD0EF \uAD00\uB828
      \uBC84\uADF8\uB97C \uACE0\uCE69\uB2C8\uB2E4 "
    m_Metadata:
      m_Items: []
  - m_Id: 14127748121853952
    m_Localized: "\uD690\uC0DD \uD3EC\uC778\uD2B8"
    m_Metadata:
